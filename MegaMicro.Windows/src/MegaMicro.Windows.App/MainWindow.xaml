<Window x:Class="MegaMicro.Windows.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Creator Command Center" Width="1180" Height="760" MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="#0D1017" Foreground="#F3F5F7" FontFamily="Segoe UI" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="KeyButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#F3F5F7"/>
            <Setter Property="Background" Value="#252B36"/>
            <Setter Property="BorderBrush" Value="#3A4351"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="KeySurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="KeySurface" Property="Background" Value="#333B49"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="KeySurface" Property="Background" Value="#1E242E"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoundKeyButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#F3F5F7"/>
            <Setter Property="Background" Value="#252B36"/>
            <Setter Property="BorderBrush" Value="#3A4351"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="KeySurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="50">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="KeySurface" Property="Background" Value="#333B49"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="KeySurface" Property="Background" Value="#1E242E"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>

        <Border Background="#11151C" BorderBrush="#252B36" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CREATOR COMMAND CENTER" Foreground="#63E6A8" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="Creator Micro → Codex key bindings" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ConnectionDot" Width="9" Height="9" Fill="#F2BA4B" Margin="0,0,8,0"/>
                    <TextBlock x:Name="ConnectionStatus" Text="Checking Creator Micro…" VerticalAlignment="Center" Foreground="#C8D0DC"/>
                    <Button Content="Probe" Click="Probe_Click" Margin="16,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="22">
            <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>

            <Border Background="#151A22" CornerRadius="12" Padding="18" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="PROFILE" Foreground="#8F99A8" FontSize="11" FontWeight="Bold"/>
                    <ComboBox x:Name="ProfileCombo" Margin="0,8,0,22" SelectionChanged="ProfileCombo_SelectionChanged"/>
                    <TextBlock Text="LAYERS" Foreground="#8F99A8" FontSize="11" FontWeight="Bold"/>
                    <Button x:Name="Layer1Button" Content="1  Codex" Click="Layer_Click" Tag="1" Margin="0,8,0,6" HorizontalContentAlignment="Left"/>
                    <Button x:Name="Layer2Button" Content="2  Layer 2" Click="Layer_Click" Tag="2" Margin="0,0,0,6" HorizontalContentAlignment="Left" Background="#252B36" Foreground="#F3F5F7"/>
                    <Button x:Name="Layer3Button" Content="3  Layer 3" Click="Layer_Click" Tag="3" Margin="0,0,0,24" HorizontalContentAlignment="Left" Background="#252B36" Foreground="#F3F5F7"/>
                    <Separator Background="#303744"/>
                    <TextBlock Text="How it works" FontWeight="SemiBold" Margin="0,20,0,8"/>
                    <TextBlock Text="1. Select an on-screen key.&#x0a;2. Learn the physical key.&#x0a;3. Choose a Codex action.&#x0a;4. Record the output shortcut.&#x0a;5. Save and press the device key." TextWrapping="Wrap" Foreground="#9BA6B5" LineHeight="21"/>
                    <TextBlock x:Name="HookStatus" Text="Global key listener: starting…" TextWrapping="Wrap" Foreground="#F2BA4B" Margin="0,24,0,0"/>
                    <TextBlock x:Name="CodexConnectionStatus" Text="Direct Codex: connecting…" TextWrapping="Wrap" Foreground="#F2BA4B" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#151A22" CornerRadius="12" Padding="24" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="LayerTitle" Text="Layer 1 · Codex" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Select a key, button, press, or turn to assign its Codex action." Foreground="#9BA6B5" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#0F1319" CornerRadius="8" Padding="12,8">
                            <TextBlock Text="Creator Micro v1 · 20 inputs" Foreground="#63E6A8"/>
                        </Border>
                    </Grid>
                    <Border Grid.Row="1" Background="#0F1319" CornerRadius="16" Padding="20" Margin="18,16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid x:Name="DeviceGrid" Width="420" Height="440">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1.25*"/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                            </Grid>
                        </Viewbox>
                    </Border>
                    <TextBlock Grid.Row="2" Text="Bindings are stored locally. Nothing is flashed to the keyboard." Foreground="#727D8E" HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#151A22" CornerRadius="12" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="SELECTED CONTROL" Foreground="#8F99A8" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="SelectedTitle" Text="Key 1" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,20"/>

                        <TextBlock Text="Label" Foreground="#C8D0DC"/>
                        <TextBox x:Name="LabelText" Margin="0,7,0,16" Padding="10,8"/>

                        <TextBlock Text="Physical trigger" Foreground="#C8D0DC"/>
                        <TextBox x:Name="TriggerText" IsReadOnly="True" Margin="0,7,0,7" Padding="10,8"/>
                        <Button x:Name="LearnTriggerButton" Content="Learn physical key" Click="LearnTrigger_Click" Margin="0,0,0,18"/>

                        <TextBlock Text="Action" Foreground="#C8D0DC"/>
                        <ComboBox x:Name="ActionCombo" Margin="0,7,0,16" Padding="8" DisplayMemberPath="Label" SelectionChanged="ActionCombo_SelectionChanged"/>

                        <StackPanel x:Name="CodexFieldsPanel" Visibility="Collapsed">
                            <TextBlock Text="Codex instruction" Foreground="#C8D0DC"/>
                            <TextBox x:Name="CodexInstructionText" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="74" VerticalScrollBarVisibility="Auto" Margin="0,7,0,14" Padding="10,8"/>
                            <TextBlock Text="Project folder" Foreground="#C8D0DC"/>
                            <Grid Margin="0,7,0,16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="WorkingDirectoryText" Padding="10,8"/>
                                <Button Grid.Column="1" Content="Browse…" Click="BrowseWorkingDirectory_Click" Margin="7,0,0,0"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="ShortcutFieldsPanel">
                            <TextBlock Text="Output shortcut" Foreground="#C8D0DC"/>
                            <TextBox x:Name="OutputText" IsReadOnly="True" Margin="0,7,0,7" Padding="10,8"/>
                            <Button x:Name="RecordOutputButton" Content="Record output shortcut" Click="RecordOutput_Click" Margin="0,0,0,10"/>
                        </StackPanel>

                        <Border Background="#0F1319" CornerRadius="8" Padding="12" Margin="0,10,0,18">
                            <TextBlock x:Name="EditorHelp" Text="Choose Focus Codex to bring the app forward, or record a shortcut to send when this Creator Micro key is pressed." TextWrapping="Wrap" Foreground="#9BA6B5"/>
                        </Border>

                        <Button Content="Save binding" Click="SaveBinding_Click" FontSize="15" Padding="16,11"/>
                        <Button x:Name="RunActionButton" Content="Test action" Click="TestAction_Click" Margin="0,8,0,0" Background="#252B36" Foreground="#F3F5F7"/>
                        <TextBlock x:Name="EditorStatus" TextWrapping="Wrap" Margin="0,14,0,0" Foreground="#63E6A8"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#11151C" BorderBrush="#252B36" BorderThickness="0,1,0,0">
            <TextBlock x:Name="FooterStatus" Text="Ready" VerticalAlignment="Center" Margin="24,0" Foreground="#8F99A8"/>
        </Border>
    </Grid>
</Window>
